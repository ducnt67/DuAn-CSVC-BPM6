VITE_API_BASE_URL=/api/v1
VITE_DEMO_PASSWORD=123

# Backend Django (đặt các biến này trên môi trường deploy, không commit giá trị thật)
DATABASE_URL=postgresql://db_user@localhost:5432/due_facility
